{
  "name": "the-construct",
  "version": "0.8.4",
  "private": true,
  "description": "Starter repo for browser games on Crowded Kingdoms: engine-agnostic platform layer, three.js holodeck hub, pixi.js program scene, a ck-exec world hub, Crowdy Studio with server and client mods and the Ask/Build/Play agent, and shell onboarding.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-dsh-web.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-dsh-web.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "dsh:copy": "node scripts/copy-dsh-web.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:headers && npm run test:release",
    "test:unit": "vitest run",
    "test:headers": "node --test security-headers.test.mjs scripts/lib/dev-server-options.test.mjs",
    "test:release": "bash scripts/ci/resolve-construct-release.test.sh && node --test scripts/ci/check-package-content.test.mjs && node scripts/ci/check-package-content.mjs packages/construct",
    "test:e2e": "playwright test",
    "check:pin": "node scripts/ci/check-sdk-pin.mjs",
    "check:grid-program": "node scripts/ci/check-grid-program-bundle.mjs",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "deploy:exec": "node scripts/deploy-exec.mjs",
    "build:exec-sources": "node scripts/build-exec-sources.mjs",
    "smoke": "node --experimental-websocket scripts/smoke.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@crowdedkingdoms/construct": "0.2.1",
    "@crowdedkingdoms/crowdyjs": "17.12.0-dev.1",
    "pixi.js": "^8.20.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@crowdedkingdoms/crowdy-dsh": "0.4.0-dev.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.0",
    "@types/three": "^0.185.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.3",
    "vitest": "^4.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
